port: 7890
socks-port: 7891
mixed-port: 7897
mode: rule
unified-delay: true
keep-alive-interval: 15
log-level: info
allow-lan: false
external-controller: 127.0.0.1:9097

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  respect-rules: true
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - 223.5.5.5
    - 119.29.29.29
  proxy-server-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver-policy:
    "geosite:cn,private":
      - 223.5.5.5
      - 119.29.29.29

tun:
  enable: true
  stack: mixed
  dns-hijack:
    - "any:53"
    - "tcp://any:53"
  auto-route: true
  auto-detect-interface: true

proxies:
  - name: "{{NODE_NAME}}"
    type: vless
    server: "{{SERVER_IP}}"
    port: {{PORT}}
    uuid: "{{UUID}}"
    network: tcp
    udp: true
    tls: true
    flow: "{{FLOW}}"
    servername: "{{SNI}}"
    reality-opts:
      public-key: "{{PUBLIC_KEY}}"
      short-id: "{{SHORT_ID}}"
    client-fingerprint: "{{FINGERPRINT}}"

proxy-groups:
  - name: "🚀 独享-AI与代码"
    type: select
    proxies:
      - "{{NODE_NAME}}"
      - DIRECT

  - name: "🌐 谷歌与Gemini"
    type: select
    proxies:
      - "{{NODE_NAME}}"
      - DIRECT

  - name: "🐟 漏网之鱼"
    type: select
    proxies:
      - "{{NODE_NAME}}"
      - DIRECT

